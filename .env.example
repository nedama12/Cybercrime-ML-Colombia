# Copy this file to .env (never commit .env) and adjust the values.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# 1 when the site is served over HTTPS (Render)
SESSION_COOKIE_SECURE=0
# Leave empty to use instance/cybercrime.db (SQLite). On Render it is set from the PostgreSQL service.
DATABASE_URL=
# Folder with model_metadata.json and the .joblib artifact (default: ./models)
MODEL_DIR=
