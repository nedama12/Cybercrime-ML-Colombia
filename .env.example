# Example configuration. Copy the names to your hosting settings; never commit real values.
APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=change-me-to-a-random-value-of-at-least-32-characters
COOKIE_SECURE=1
BEHIND_PROXY=1
# SQLite file on a persistent disk
USER_DB_PATH=/var/data/cybercrime.sqlite3
# Accounts that receive a role when they register (comma separated)
ANALYST_EMAILS=analyst@example.org
ADMIN_EMAILS=admin@example.org
PORT=5000
